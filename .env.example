# MOD-15 — Notification Service
# Copy to .env and fill values before running in production

# Service
PORT=8015
LOG_LEVEL=INFO

# Twilio (SMS) — production only
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AWS SES (Email) — production only
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
SES_FROM_EMAIL=noreply@hvp.health

# Feature flags
MOCK_PROVIDER=true   # set false in production
